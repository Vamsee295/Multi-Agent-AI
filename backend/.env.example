ENV=development
PORT=8000

# Supabase Auth Configuration
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
SUPABASE_AUDIENCE=authenticated

# MongoDB Database (Atlas or local)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=customer_support_ai

# LLM Provider: "groq" | "openai" | "gemini" | "mock"
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# Intent Detection & RAG Configuration
INTENT_DETECTION_MODE=hybrid
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=vectorstore/index
KNOWLEDGE_BASE_DIR=knowledge_base
RETRIEVAL_SCORE_THRESHOLD=0.0

# CORS Allowed Origins (Comma-separated for multi-origin support)
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-app.vercel.app
